        "title": "False Color",
        "assets": ["cog"],
        "bidx": [8, 4, 3],
        "rescale": [
          [0, 200],
          [0, 200],
          [0, 200]
        ]
      },
      "SWIR": {
        "title": "SWIR",
        "assets": ["cog"],
        "bidx": [12, 8, 4],
