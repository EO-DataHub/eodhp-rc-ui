  "ukcp": {
    "renders": {
      "pr": {
        "title": "Precipitation (mm/day)",
        "assets": ["reference_file"],
        "variable": "pr",
        "reference": true,
        "colormap_name": "viridis",
        "rescale": [0, 10]
      },
      "prsn": {
        "title": "Snowfall Flux (mm/day)",
        "assets": ["reference_file"],
        "variable": "prsn",
        "reference": true,
