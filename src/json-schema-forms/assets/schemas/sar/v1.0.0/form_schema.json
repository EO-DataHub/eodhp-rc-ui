{
  "$id": "https://test.eodatahub.org/schemas/sar/v1.0.0/form_schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SAR v1.0.0 Form Schema",
  "type": "object",
  "properties": {
    "sar:instrument_mode": {
      "$comment": "Items must be overridden in the implementing schema to cater for specific modes.",
      "type": "string",
      "title": "Instrument Mode",
      "anyOf": [
        {
          "title": "All instrument modes",
          "enum": ["%"]
        }
      ]
    },
    "sar:product_type": {
      "$comment": "Items must be overridden in the implementing schema to cater for specific products.",
      "type": "string",
      "title": "Product Type",
      "anyOf": [
        {
          "title": "All products",
          "enum": ["%"]
        }
      ]
    },
    "sar:polarizations": {
      "type": "string",
      "title": "Polarizations",
      "anyOf": [
        {
          "title": "Single HH",
          "enum": ["HH"]
        },
        {
          "title": "Single HV",
          "enum": ["HV"]
        },
        {
          "title": "Single VH",
          "enum": ["VH"]
        },
        {
          "title": "Single VV",
          "enum": ["VV"]
        },
        {
          "title": "Dual HH/VV",
          "enum": ["HH,VV"]
        },
        {
          "title": "Cross HH/HV",
          "enum": ["HH,HV"]
        },
        {
          "title": "Cross VV/VH",
          "enum": ["VV,VH"]
        }
      ]
    },
    "sar:observation_direction": {
      "type": "string",
      "title": "Observation Direction",
      "default": "%",
      "anyOf": [
        {
          "title": "Both",
          "enum": ["%"]
        },
        {
          "title": "Right",
          "enum": ["right"]
        },
        {
          "title": "Left",
          "enum": ["left"]
        }
      ]
    }
  },
  "required": ["sar:instrument_mode", "sar:polarizations", "sar:product_type"]
}
