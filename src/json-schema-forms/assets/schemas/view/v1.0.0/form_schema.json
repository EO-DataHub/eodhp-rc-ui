{
  "$id": "https://test.eodatahub.org/schemas/view/v1.0.0/form_schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "view:incidence_angle": {
      "type": "number",
      "title": "Incidence angle",
      "default": 0.0,
      "minimum": 0.0,
      "maximum": 90.0,
      "operator": "<="
    },
    "view:sun_azimuth": {
      "type": "number",
      "title": "Sun azimuth angle",
      "default": 0.0,
      "minimum": 0.0,
      "maximum": 360.0,
      "operator": "<="
    },
    "view:azimuth": {
      "type": "number",
      "title": "Viewing azimuth angle",
      "default": 0.0,
      "minimum": 0.0,
      "maximum": 360.0,
      "operator": "<="
    },
    "view:sun_elevation": {
      "type": "number",
      "title": "Sun elevation angle",
      "default": 0.0,
      "minimum": -90.0,
      "maximum": 90.0,
      "operator": ">="
    }
  }
}
