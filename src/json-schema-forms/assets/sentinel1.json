{
  "$id": "https://test.eodatahub.org/schemas/sentinel1.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sentinel 1 SAR",
  "type": "object",
  "required": ["collection_id"],
  "properties": {
    "collection_id": {
      "const": "sentinel1"
    },
    "start_datetime": {
      "$ref": "schemas/eodh/v1.0.0/form_schema.json#/properties/start_datetime"
    },
    "end_datetime": {
      "$ref": "schemas/eodh/v1.0.0/form_schema.json#/properties/end_datetime"
    },
    "platform": {
      "$ref": "#/$defs/platform_international_designator",
      "title": "Datasource"
    },
    "sat:orbit_state": {
      "$ref": "schemas/sat/v1.0.0/form_schema.json#/properties/sat:orbit_state",
      "title": "Orbit Direction"
    },
    "sar:polarizations": {
      "$ref": "schemas/sar/v1.0.0/form_schema.json#/properties/sar:polarizations",
      "title": "Polarisation"
    },
    "instrument_mode": {
      "$ref": "#/$defs/instrument_mode",
      "title": "Mode"
    }
  },
  "$defs": {
    "platform_international_designator": {
      "$ref": "schemas/sat/v1.0.0/form_schema.json#/properties/sat:platform_international_designator",
      "default": "%",
      "anyOf": [
        {
          "type": "string",
          "title": "All",
          "enum": [
            "%"
          ]
        },
        {
          "title": "Sentinel 1a",
          "enum": [
            "sentinel1a"
          ]
        },
        {
          "title": "Sentinel 1b",
          "enum": [
            "sentinel1b"
          ]
        }
      ]
    },
    "instrument_mode": {
      "$ref": "schemas/sar/v1.0.0/form_schema.json#/properties/sar:instrument_mode",
      "anyOf": [
        {
          "title": "Wave",
          "enum": [
            "WV"
          ]
        },
        {
          "title": "Stripmap",
          "enum": [
            "SM"
          ]
        },
        {
          "title": "Interferometric Wide Swath",
          "enum": [
            "IW"
          ]
        },
        {
          "title": "Extra-Wide Swath",
          "enum": [
            "EW"
          ]
        }
      ]
    }
  }
}
