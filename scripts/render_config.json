{
    "stac.ceda.ac.uk": {
        "sentinel2_ard": {
            "eodhrc:api": "https://staging.eodatahub.org.uk/titiler/core",
            "eodhrc:type": "raster-multiband",
            "renders": {
                "True Color": {
                    "title": "RGB",
                    "assets": ["cog"],
                    "bidx": [4, 3, 2],
                    "rescale": [[0, 200], [0, 200], [0, 200]]
                },
                "False Color": {
                    "title": "False Color",
                    "assets": ["cog"],
                    "bidx": [8, 4, 3],
                    "rescale": [[0, 200], [0, 200], [0, 200]]
                },
                "SWIR": {
                    "title": "SWIR",
                    "assets": ["cog"],
                    "bidx": [12, 8, 4],
                    "rescale": [[0, 200], [0, 200], [0, 200]]
                }
            }
        },
        "eocis-lst-s3a-day": {
            "eodhrc:api": "https://staging.eodatahub.org.uk/titiler/xarray",
            "eodhrc:type": "multidim-multivar",
            "renders": {
                "lst": {
                    "title": "Land Surface Temperature (°C)",
                    "assets": ["reference_file"],
                    "variable": "lst",
                    "reference": true,
                    "colormap_name": "coolwarm",
                    "rescale": [-5, 20]
                },
                "ndvi": {
                    "title": "Vegetation Index (°C)",
                    "assets": ["reference_file"],
                    "variable": "ndvi",
                    "reference": true,
                    "colormap_name": "Greens",
                    "rescale": [0, 1]
                }
            }
        },
        "eocis-sst-cdrv3": {
            "eodhrc:api": "https://staging.eodatahub.org.uk/titiler/xarray",
            "eodhrc:type": "multidim-multivar"
        },
        "ukcp": {
            "eodhrc:api": "https://staging.eodatahub.org.uk/titiler/xarray",
            "eodhrc:type": "multidim-singlevar-items",
            "eodhrc:renders_filters": {
                "pr": {
                    "item_filter_cql2": "id LIKE '%.pr.%'"
                },
                "prsn": {
                    "item_filter_cql2":"id LIKE '%.prsn.%'"
                },
                "tas": {
                    "item_filter_cql2": "id LIKE '%.tas.%'"
                }
            },
            "renders": {
                "pr": {
                    "title": "Precipitation (mm/day)",
                    "assets": ["reference_file"],
                    "variable": "pr",
                    "reference": true,
                    "colormap_name": "viridis",
                    "rescale": [0, 10]
                },
                "prsn": {
                    "title": "Snowfall Flux (mm/day)",
                    "assets": ["reference_file"],
                    "variable": "prsn",
                    "reference": true,
                    "colormap_name": "viridis",
                    "rescale": [0, 10]
                },
                "tas": {
                    "title": "Mean Air Temperature (°C)",
                    "assets": ["reference_file"],
                    "variable": "tas",
                    "reference": true,
                    "colormap_name": "coolwarm",
                    "rescale": [-5, 20]
                }
            }
        },
        "land_cover": {
            "eodhrc:api": "https://staging.eodatahub.org.uk/titiler/core",
            "eodhrc:type": "raster-singleband",
            "renders": {
                "title": "Land Cover Map",
                "assets": "GeoTIFF",
                "colormap": {
                    "0": "#000000",
                    "10": "#ffff64",
                    "11": "#ffff64",
                    "12": "#ffff00",
                    "20": "#aaf0f0",
                    "30": "#dbf064",
                    "40": "#c8c864",
                    "50": "#006400",
                    "60": "#00a000",
                    "61": "#00a000",
                    "62": "#aac800",
                    "70": "#003c00",
                    "71": "#003c00",
                    "72": "#005000",
                    "80": "#400500",
                    "81": "#400500",
                    "82": "#400640",
                    "90": "#788200",
                    "100": "#1400a0",
                    "110": "#be9500",
                    "120": "#150064",
                    "121": "#784c00",
                    "122": "#150064",
                    "130": "#ffb432",
                    "140": "#ffdcd2",
                    "150": "#ffebaf",
                    "151": "#ffc964",
                    "152": "#ffd278",
                    "153": "#ffebaf",
                    "160": "#00785a",
                    "170": "#009678",
                    "180": "#00dc80",
                    "190": "#c31300",
                    "200": "#fff5d7",
                    "201": "#dcdcdc",
                    "202": "#fff5d7",
                    "210": "#0046c8",
                    "220": "#ffffff"
                  }
            }
        }
    },
    "staging.eodatahub.org.uk/api/catalogue/stac/catalogs/supported-datasets/catalogs/airbus": {
        "airbus_sar_data": {
            "eodhrc:api": "https://staging.eodatahub.org.uk/titiler/core",
            "eodhrc:type": "raster-singleband",
            "renders": {
                "preview": {
                    "title": "Data Preview",
                    "assets": "thumbnail"
                }
            }
        },
        "airbus_phr_data": {
            "eodhrc:api": "https://staging.eodatahub.org.uk/titiler/core",
            "eodhrc:type": "png",
            "renders": {
                "preview": {
                    "title": "Data Preview",
                    "assets": "quicklook"
                }
            }
        },
        "airbus_spot_data": {
            "eodhrc:api": "https://staging.eodatahub.org.uk/titiler/core",
            "eodhrc:type": "png",
            "renders": {
                "preview": {
                    "title": "Data Preview",
                    "assets": "quicklook"
                }
            }
        }
    }
}
