VITE_BASE_PATH=/
VITE_HUB_BASE_URL=https://staging.eodatahub.org.uk
# Optional: Workflow/Notebook Catalogue API base (e.g. https://api.example.com/api/v1.0). Falls back to VITE_HUB_BASE_URL + /api/v1.0 if not set.
VITE_CATALOGUE_API_URL=
VITE_KEYCLOAK_CLIENT_ID=sparkgeo
VITE_KEYCLOAK_REALM=eodhp
VITE_KEYCLOAK_URL=https://staging.eodatahub.org.uk/keycloak
VITE_TITILER_BASE_URL=https://staging.eodatahub.org.uk/titiler
VITE_WORKSPACE_API_TOKEN=
VITE_RC_SUPPORT_UTILS_URL=
VITE_GA_MEASUREMENT_ID=
VITE_WORKFLOW_RESULTS_WORKSPACE_NAME=
# Open Cosmos OAuth (Provider accounts page) — ported from eodhp-workspace-ui. Redirect URI
# must be registered with Open Cosmos and point at this app's own base URL (no path/hash).
VITE_OPEN_COSMOS_AUTH_DOMAIN=https://login.open-cosmos.com
VITE_OPEN_COSMOS_AUDIENCE=https://beeapp.open-cosmos.com
VITE_OPEN_COSMOS_REDIRECT_URI=
VITE_OPEN_COSMOS_SCOPE=openid profile email offline_access
VITE_OPEN_COSMOS_CLIENT_ID=